# Copy to .env and fill in JWT_SECRET. Values below are for local development.

PORT=3000

# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Allowed browser origin(s) for CORS, comma-separated.
FRONTEND_URL=http://localhost:4200

# Storage. Leave unset locally: data.sqlite and uploads/ go in this folder.
# On Railway, point them at the mounted volume, for example:
#   DATA_DIR=/data
#   DB_PATH=/data/data.sqlite
#   UPLOAD_DIR=/data/uploads
# DATA_DIR=
# DB_PATH=
# UPLOAD_DIR=

# Login/register attempts allowed per IP per minute (default 10).
# AUTH_RATE_LIMIT=10

# Swagger UI at /api is on locally; set to true to keep it in production.
# SWAGGER_ENABLED=false
